# Local development example only. Production-like Kubernetes environments must
# set APP_ENV explicitly. test/test-app/staging/production disable sensitive
# local fallbacks and require secrets through env or *_FILE.
APP_ENV=local

JWT_SECRET=change-me-with-at-least-32-random-bytes
AUTH_DB_DSN=tropical:tropical@tcp(mysql:3306)/tropical_auth?parseTime=true&charset=utf8mb4
AUDIT_DB_DSN=tropical:tropical@tcp(mysql:3306)/tropical_audit?parseTime=true&charset=utf8mb4
INVENTORY_DB_DSN=tropical:tropical@tcp(mysql:3306)/tropical_inventory?parseTime=true&charset=utf8mb4
SALES_DB_DSN=tropical:tropical@tcp(mysql:3306)/tropical_sales?parseTime=true&charset=utf8mb4
CHAT_DB_DSN=tropical:tropical@tcp(mysql:3306)/tropical_chat?parseTime=true&charset=utf8mb4
BOOTSTRAP_ADMIN_EMAIL=admin@tropical.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThis123!
NEXT_PUBLIC_API_URL=http://localhost:8080

# Shared DB runtime bounds for DB-backed services. Start conservatively and tune
# from observed metrics before scaling replicas.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=3m
DB_CONN_MAX_IDLE_TIME=1m
DB_PING_ATTEMPTS=30
DB_PING_DELAY=2s
DB_PING_TIMEOUT=3s
DB_QUERY_TIMEOUT=5s
DB_CONNECT_TIMEOUT=3s
DB_READ_TIMEOUT=5s
DB_WRITE_TIMEOUT=5s

# P0 traffic protection. These are per-process limits; if a service is scaled
# horizontally, effective cluster-wide capacity scales with replica count.
GATEWAY_MAX_IN_FLIGHT=100
GATEWAY_MAX_SSE_IN_FLIGHT=100
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_GLOBAL_RATE_LIMIT_ATTEMPTS=100
AUTH_LOGIN_RATE_LIMIT_WINDOW=1m
AUTH_LOGIN_RATE_LIMIT_MAX_KEYS=10000
CHAT_MAX_SSE_CONNECTIONS=100
CHAT_MAX_SSE_CONNECTIONS_PER_USER=3

# Backend file logging (all logs are also emitted to stdout by default).
LOG_DIR=/var/log/tropical
LOG_MAX_SIZE_MB=25
LOG_MAX_BACKUPS=5
LOG_STDOUT=true
